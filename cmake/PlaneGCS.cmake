# SPDX-License-Identifier: MIT
# Exact public-source extraction. Upstream code stays in the build directory;
# downloaded originals are verified before applying the documented C++20 patch.
set(ALLOY_PLANEGCS_REVISION ec6852e6caadf55045881a6003cc7ad038c8d2a7)
set(_pg_root "${CMAKE_BINARY_DIR}/_deps/planegcs")
set(_pg_manifest "${CMAKE_CURRENT_LIST_DIR}/../third_party/planegcs/sources.json")
file(READ "${_pg_manifest}" _pg_json)
string(JSON _pg_count LENGTH "${_pg_json}" files)
math(EXPR _pg_last "${_pg_count}-1")
foreach(_i RANGE ${_pg_last})
    string(JSON _name MEMBER "${_pg_json}" files ${_i})
    string(JSON _url GET "${_pg_json}" files "${_name}" url)
    string(JSON _hash GET "${_pg_json}" files "${_name}" sha256)
    set(_original "${_pg_root}/original/${_name}")
    get_filename_component(_dir "${_original}" DIRECTORY)
    file(MAKE_DIRECTORY "${_dir}")
    if(NOT EXISTS "${_original}")
        file(DOWNLOAD "${_url}" "${_original}" EXPECTED_HASH SHA256=${_hash} TLS_VERIFY ON STATUS _status)
        list(GET _status 0 _code)
        if(NOT _code EQUAL 0)
            file(REMOVE "${_original}")
            message(FATAL_ERROR "PlaneGCS source download failed: ${_status}")
        endif()
    endif()
    file(SHA256 "${_original}" _actual)
    if(NOT _actual STREQUAL _hash)
        message(FATAL_ERROR "PlaneGCS cached source hash mismatch: ${_name}")
    endif()
    if(NOT _name STREQUAL "src/Mod/Sketcher/App/planegcs/GCS.cpp")
        configure_file("${_original}" "${_pg_root}/source/${_name}" COPYONLY)
    endif()
endforeach()
set(_gcs "${_pg_root}/source/src/Mod/Sketcher/App/planegcs")
file(READ "${_pg_root}/original/src/Mod/Sketcher/App/planegcs/GCS.cpp" _gcs_text)
string(REGEX MATCHALL "std::unreachable\\(\\)" _matches "${_gcs_text}")
list(LENGTH _matches _match_count)
if(NOT _match_count EQUAL 1)
    message(FATAL_ERROR "Pinned PlaneGCS C++20 patch no longer applies exactly once")
endif()
string(REPLACE "std::unreachable();" "std::abort();" _gcs_text "${_gcs_text}")
string(PREPEND _gcs_text "// Alloy portability modification, 2026-10-11: replace C++23 std::unreachable with C++20 std::abort.\n#include <cstdlib>\n")
set(_previous_gcs "")
if(EXISTS "${_gcs}/GCS.cpp")
    file(READ "${_gcs}/GCS.cpp" _previous_gcs)
endif()
if(NOT _gcs_text STREQUAL _previous_gcs)
    file(WRITE "${_gcs}/GCS.cpp" "${_gcs_text}")
endif()

option(ALLOY_FETCH_SOLVER_HEADERS "Fetch pinned Eigen/Boost headers if matching local headers are absent" ON)
find_path(ALLOY_EIGEN_INCLUDE_DIR Eigen/Version PATH_SUFFIXES eigen3)
find_path(ALLOY_BOOST_INCLUDE_DIR boost/version.hpp)
set(_eigen_ok FALSE)
if(ALLOY_EIGEN_INCLUDE_DIR)
    file(READ "${ALLOY_EIGEN_INCLUDE_DIR}/Eigen/Version" _version)
    if(_version MATCHES "#define EIGEN_MAJOR_VERSION 5" AND _version MATCHES "#define EIGEN_MINOR_VERSION 0" AND _version MATCHES "#define EIGEN_PATCH_VERSION 1([^0-9]|$)")
        set(_eigen_ok TRUE)
    endif()
endif()
set(_boost_ok FALSE)
if(ALLOY_BOOST_INCLUDE_DIR)
    file(READ "${ALLOY_BOOST_INCLUDE_DIR}/boost/version.hpp" _version)
    if(_version MATCHES "#define BOOST_VERSION 109000([^0-9]|$)")
        set(_boost_ok TRUE)
    endif()
endif()
include(FetchContent)
if(NOT _eigen_ok)
    if(NOT ALLOY_FETCH_SOLVER_HEADERS)
        message(FATAL_ERROR "Eigen 5.0.1 headers required; set ALLOY_EIGEN_INCLUDE_DIR")
    endif()
    FetchContent_Declare(alloy_eigen URL https://gitlab.com/libeigen/eigen/-/archive/5.0.1/eigen-5.0.1.tar.gz
        URL_HASH SHA256=e9c326dc8c05cd1e044c71f30f1b2e34a6161a3b6ecf445d56b53ff1669e3dec
        DOWNLOAD_EXTRACT_TIMESTAMP FALSE SOURCE_SUBDIR alloy-headers-only)
    FetchContent_MakeAvailable(alloy_eigen)
    set(ALLOY_EIGEN_INCLUDE_DIR "${alloy_eigen_SOURCE_DIR}")
endif()
if(NOT _boost_ok)
    if(NOT ALLOY_FETCH_SOLVER_HEADERS)
        message(FATAL_ERROR "Boost 1.90.0 headers required; set ALLOY_BOOST_INCLUDE_DIR")
    endif()
    FetchContent_Declare(alloy_boost URL https://archives.boost.io/release/1.90.0/source/boost_1_90_0.tar.bz2
        URL_HASH SHA256=49551aff3b22cbc5c5a9ed3dbc92f0e23ea50a0f7325b0d198b705e8ee3fc305
        DOWNLOAD_EXTRACT_TIMESTAMP FALSE SOURCE_SUBDIR alloy-headers-only)
    FetchContent_MakeAvailable(alloy_boost)
    set(ALLOY_BOOST_INCLUDE_DIR "${alloy_boost_SOURCE_DIR}")
endif()

add_library(alloy_planegcs SHARED
    "${_gcs}/GCS.cpp" "${_gcs}/Geo.cpp" "${_gcs}/Constraints.cpp" "${_gcs}/SubSystem.cpp" "${_gcs}/qp_eq.cpp")
set_target_properties(alloy_planegcs PROPERTIES AUTOMOC OFF VERSION 0.1.0 SOVERSION 0)
target_include_directories(alloy_planegcs SYSTEM PUBLIC "${_gcs}" "${_pg_root}/source/src"
    "${CMAKE_CURRENT_LIST_DIR}/../third_party/planegcs/shims" "${ALLOY_EIGEN_INCLUDE_DIR}" "${ALLOY_BOOST_INCLUDE_DIR}")
target_compile_definitions(alloy_planegcs PRIVATE Sketcher_EXPORTS PUBLIC EIGEN_MPL2_ONLY)
message(STATUS "PlaneGCS ${ALLOY_PLANEGCS_REVISION}: shared; Eigen 5.0.1; Boost 1.90.0")
